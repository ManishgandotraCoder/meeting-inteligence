APP_NAME=Smart Meet API
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/meetinglens

OLLAMA_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
PROMPT_VERSION=rag-v2

MAX_UPLOAD_SIZE_MB=5
MAX_AUDIO_UPLOAD_SIZE_MB=25
MAX_TRANSCRIPT_CHARS=400000
WHISPER_MODEL=base
WHISPER_LANGUAGE=
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

RAG_CANDIDATE_K=10
RAG_TOP_K=6
RAG_MIN_SCORE=0.18
RAG_HISTORY_MESSAGES=6

ENABLE_AI_TRACES=false
